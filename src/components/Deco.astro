---
// Detalles sutiles: hongos, paz y zen (SVG con currentColor, decorativos).
const { kind, class: cls = '', style = '' } = Astro.props;
---
<span class={`deco ${cls}`} style={style} aria-hidden="true">
  {kind === 'mushroom' && (
    <svg viewBox="0 0 40 44"><path d="M3 24Q3 4 20 4t17 20Z" fill="currentColor" /><path d="M15 24h10v13q0 5-5 5t-5-5Z" fill="currentColor" opacity=".7" /><g fill="#f3e6c9"><circle cx="13" cy="15" r="3" /><circle cx="24" cy="11" r="2.4" /><circle cx="29" cy="19" r="2.6" /></g></svg>
  )}
  {kind === 'peace' && (
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="20" cy="20" r="16" /><path d="M20 4v32M20 20l-11.5 11.5M20 20l11.5 11.5" /></svg>
  )}
  {kind === 'enso' && (
    <svg viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="3.4" stroke-linecap="round"><path d="M22 4.5A16 16 0 1 1 9 10.5" /></svg>
  )}
  {kind === 'lotus' && (
    <svg viewBox="0 0 48 36" fill="currentColor"><path d="M24 4C18 12 18 22 24 30 30 22 30 12 24 4Z" /><path d="M20 28C10 26 5 18 4 12 14 12 20 18 22 28Z" opacity=".8" /><path d="M28 28C38 26 43 18 44 12 34 12 28 18 26 28Z" opacity=".8" /><path d="M4 32h40" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none" /></svg>
  )}
</span>
